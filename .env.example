# Create a Web app at https://developer.xero.com/app/manage and copy these values.
XERO_CLIENT_ID=your-client-id
XERO_CLIENT_SECRET=your-client-secret

# Register this exact URL in the Xero app's Redirect URIs. Xero permits localhost,
# but not 127.0.0.1, for an HTTP testing callback.
XERO_REDIRECT_URI=http://localhost:3000/callback

# Optional: if the connected user can access more than one organisation, set the
# tenant ID you want to use. Otherwise the first connected organisation is stored.
# XERO_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
